# Irfaran environment. Copy to .env and fill in.
# .env is gitignored. Never commit a real token.
#
# These were named FOGMAP_* before the project was renamed in 0.10.0. Those
# still work - IRFARAN_* wins where both are set - so an existing .env can be
# updated whenever it suits rather than before the next restart.

# What Docker Compose calls this stack. Compose derives it from the folder
# name when unset, so two checkouts in folders both called Irfaran are the
# same stack as far as Compose is concerned - bringing one up replaces the
# other's containers. Set this on the second one.
# COMPOSE_PROJECT_NAME=irfaran

# Shared secret required on every POST, PATCH and DELETE request.
# Optional: leave it blank and Irfaran generates one on first start and shows
# it on the setup screen. Set it to choose your own instead.
# Generate one with: openssl rand -hex 32
IRFARAN_TOKEN=

# Host directory bind-mounted to /data in the api container.
# Holds irfaran.db, raster blobs, the rendered tile pyramid and planet.pmtiles.
IRFARAN_DATA_HOST=./data

# Port the API listens on, on the host.
IRFARAN_API_PORT=8000

# Port the web UI listens on, on the host.
IRFARAN_WEB_PORT=8080

# Ingest tuning. All optional - unset means the documented default.
# Tracks split when the trace jumps further than this in time or distance,
# which is what stops a flight drawing a line across the map.
IRFARAN_GAP_SECONDS=300
IRFARAN_GAP_METRES=1000

# Fixes reporting worse accuracy than this are dropped. Fixes reporting no
# accuracy at all are kept - most GPX files carry none.
IRFARAN_MAX_ACCURACY_M=50

# Ceiling on the trail brush. Fog clears at the per-event radius; the trail is
# a thinner line drawn down the middle of the corridor it clears.
IRFARAN_TRAIL_MAX_RADIUS_M=3

# Colour of the unknown, per map theme. Overrides the picker in settings.
# Baked into the tiles, so changing it re-renders them.
# IRFARAN_FOG_COLOUR_DARK=#1c1e23
# IRFARAN_FOG_COLOUR_LIGHT=#e8e8e4

# How solid the fog is over ground you have not visited, 0 to 255.
# Not 255: at full opacity the map underneath is completely hidden.
IRFARAN_FOG_ALPHA=214

# How far the fog fades out where it meets explored ground, in pixels.
IRFARAN_FOG_EDGE_PX=2.5

# --- Production only, used by docker-compose.prod.yml ---

# Image tag to pull. Always an explicit version, never latest - a host that
# silently changes version when it pulls is a host nobody can debug.
IRFARAN_IMAGE_TAG=

# Public hostname the instance is reached at.
DOMAIN=

# How many worker processes render tiles at once. Defaults to one less than
# the number of cores, so a bulk import leaves the machine usable.
# IRFARAN_RENDER_WORKERS=7

# Trail colouring: ember, ice, moss or mono. Overrides the picker in settings.
# Baked into the tiles, so changing it re-renders them.
# IRFARAN_TRAIL_RAMP=ember

# Where the PMTiles basemap lives on the host. Defaults to the data
# directory. Worth separating when that sits on a small fast disk: the planet
# archive is around 137 GB of public map data that can always be fetched
# again, while everything else there is irreplaceable and tiny.
#
# Keep it on an SSD even so. Serving the map is random reads, not streaming -
# roughly one small range request per tile, a few dozen per screenful - so seek
# time is the whole cost, and a spinning disk pays ten milliseconds a read plus
# several seconds to spin up if it was parked. If the planet will not fit on
# fast storage, take a regional extract rather than moving it to slow storage:
#   pmtiles extract https://build.protomaps.com/DATE.pmtiles planet.pmtiles \
#     --bbox=MIN_LON,MIN_LAT,MAX_LON,MAX_LAT
# IRFARAN_BASEMAP_HOST=/mnt/cache/irfaran-basemap

# How long a write waits for another to finish before giving up, in seconds.
# SQLite allows one writer at a time, and a tracker delivering a few hundred
# buffered fixes holds it for a while. Raise it if a busy instance returns 503.
# IRFARAN_BUSY_TIMEOUT_S=30
