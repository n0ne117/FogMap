# FogMap environment. Copy to .env and fill in.
# .env is gitignored. Never commit a real token.

# Shared secret required on every POST, PATCH and DELETE request.
# Any non-empty string. Generate one with: openssl rand -hex 32
# If this is unset the API refuses all mutating requests.
FOGMAP_TOKEN=

# Host directory bind-mounted to /data in the api container.
# Holds fogmap.db, raster blobs, the rendered tile pyramid and planet.pmtiles.
FOGMAP_DATA_HOST=./data

# Port the API listens on, on the host.
FOGMAP_API_PORT=8000

# Port the web UI listens on, on the host.
FOGMAP_WEB_PORT=8080

# Production only. Image tag pulled by docker-compose.prod.yml.
# Always an explicit version, never latest.
FOGMAP_IMAGE_TAG=

# Production only. Public hostname the instance is reached at.
DOMAIN=
