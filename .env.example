# FogMap environment. Copy to .env and fill in.
# .env is gitignored. Never commit a real token.

# Shared secret required on every POST, PATCH and DELETE request.
# Any non-empty string. Generate one with: openssl rand -hex 32
# If this is unset the API refuses all mutating requests.
FOGMAP_TOKEN=

# Host directory bind-mounted to /data in the api container.
# Holds fogmap.db, raster blobs, the rendered tile pyramid and planet.pmtiles.
FOGMAP_DATA_HOST=./data

# Port the API listens on, on the host.
FOGMAP_API_PORT=8000

# Port the web UI listens on, on the host.
FOGMAP_WEB_PORT=8080

# Ingest tuning. All optional - unset means the documented default.
# Tracks split when the trace jumps further than this in time or distance,
# which is what stops a flight drawing a line across the map.
FOGMAP_GAP_SECONDS=300
FOGMAP_GAP_METRES=1000

# Fixes reporting worse accuracy than this are dropped. Fixes reporting no
# accuracy at all are kept - most GPX files carry none.
FOGMAP_MAX_ACCURACY_M=50

# Ceiling on the trail brush. Fog clears at the per-event radius; the trail is
# a thinner line drawn down the middle of the corridor it clears.
FOGMAP_TRAIL_MAX_RADIUS_M=5

# --- Production only, used by docker-compose.prod.yml ---

# Image tag to pull. Always an explicit version, never latest - a host that
# silently changes version when it pulls is a host nobody can debug.
FOGMAP_IMAGE_TAG=

# Public hostname the instance is reached at.
DOMAIN=
